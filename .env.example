# ─── Firebase ────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIAL_PATH=./firebase-service-account.json

# ─── Business Client ──────────────────────────────────────────────────────────
# Default client ID — used as fallback in agent tools
CLIENT_ID=your-client-id-here

# ─── Application ─────────────────────────────────────────────────────────────
# "development" enables debug logging, "production" disables it
APP_ENV=development
AGENT_TOOLS_DEBUG=false

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8090

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Outside APP_ENV=development/test the app refuses to start if this is unset,
# the placeholder below, or shorter than 32 characters.
JWT_SECRET_KEY=change-me-to-a-64-char-random-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin Credentials ───────────────────────────────────────────────────────
# Change these before deploying to production! Production startup fails if
# ADMIN_PASSWORD is unset, the placeholder below, or shorter than 12 characters.
# The admin account is pre-seeded — see seed_firestore.py
ADMIN_USERNAME=automite_admin
ADMIN_PASSWORD=Aut0m!te@Secure#2026

# ─── Google OAuth2 (Calendar Integration) ────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google GenAI ────────────────────────────────────────────────────────────
# Get your key from Google AI Studio
GEMINI_API_KEY=

# ─── Encryption ──────────────────────────────────────────────────────────────
# Master secret (>= 32 chars) encrypting Google OAuth tokens at rest. Required in production.
# Changing it makes stored tokens unreadable (clients must reconnect Google).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─── Public base URL ─────────────────────────────────────────────────────────
BASE_URL=http://localhost:8090

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API with credentials.
# Production startup fails if this is empty or contains "*".
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────
# Get your credentials from developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── ElevenLabs Conversational AI ────────────────────────────────────────────
# Get your API key from elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ─── Contact Form Email (Gmail SMTP) ──────────────────────────────────
# Gmail address that will SEND form emails. Must have 2-Step Verification enabled.
# SMTP_PASSWORD is a Google App Password (16 chars). Get it at:
#   myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
CONTACT_EMAIL=aiautomite@gmail.com
